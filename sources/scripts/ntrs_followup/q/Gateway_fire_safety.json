vide a useful measure in communicating progress and identifying development needs to fill exploration gaps.  The intent is to provide a very high-level overview describing the projects that are supporting gap closure and provide references to additional technical details, progress, and KPPs.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"US","submissionId":20210015025,"endDate":"2021-07-15T05:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"International Conference on Environmental Systems, Inc"}},"meetingId":"ed8db3135f10407d87a3a3bdd1684e8f","id":"a1a86ece10784aeab5d8e8c108877927"}],"name":"50th International Conference on Environmental Systems ","location":"Virtual","id":"ed8db3135f10407d87a3a3bdd1684e8f","url":"https://www.ices.space/","startDate":"2021-07-12T05:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20210010866,"type":"SUPERSEDED_BY","title":"NASA Environmental Control and Life Support Technology Development for Exploration: 2020 to 2021 Overview","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20210016776,"type":"SEE_ALSO","title":"NASA Environmental Control and Life Support Technology Development for Exploration: 2020 to 2021 Overview","stiType":"PRESENTATION","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/vnd.openxmlformats-officedocument.wordprocessingml.document","name":"ICES_384-FY2021 ECLSS Overview-final.docx","type":"STI","links":{"original":"/api/citations/20210015025/downloads/ICES_384-FY2021%20ECLSS%20Overview-final.docx","pdf":"/api/citations/20210015025/downloads/ICES_384-FY2021%20ECLSS%20Overview-final.docx.pdf","fulltext":"/api/citations/20210015025/downloads/ICES_384-FY2021%20ECLSS%20Overview-final.docx.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"bucket