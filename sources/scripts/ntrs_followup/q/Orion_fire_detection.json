{"stats":{"took":66,"total":3,"estimate":false,"maxScore":144.14612},"results":[{"_meta":{"score":144.14612},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20090020655,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"f53713734b864ffcb01371c249040954","belongsToAuthors":false},"subjectCategories":["Lunar And Planetary Science And Exploration"],"exportControl":{"isExportControl":"NO","submissionId":20090020655,"ear":"NO","id":"f8bf342588e84a44995600c07ec695b5","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["JSC-CN-18294","09ICES-0035","Report Number: JSC-CN-18294","Report Number: 09ICES-0035"],"fundingNumbers":[{"number":"WBS 604746.02.22.09.01.01.10","submissionId":20090020655,"id":"1be2bf75e53149b79273f00ff504b308","type":"WBS"}],"title":"Smoke Detection for the Orion Crew Exploration Vehicle","stiType":"PREPRINT","distribution":"PUBLIC","submittedDate":"2013-08-24T18:30:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20090020655,"meta":{"author":{"name":"Sutin, Brian M."},"organization":{"name":"Hamilton Sundstrand Corp.","location":"Houston, TX, United States"}},"id":"0138c7b1357a413eb720c8e645db3958"},{"sequence":1,"submissionId":20090020655,"meta":{"author":{"name":"Niu, William"},"organization":{"name":"Hamilton Sundstrand Corp.","location":"Houston, TX, United States"}},"id":"c98ba5ef266c41f78b2c184d5831d5c2"},{"sequence":2,"submissionId":20090020655,"meta":{"author":{"name":"Steiner, George"},"organization":{"name":"Hamilton Sundstrand Corp.","location":"Houston, TX, United States"}},"id":"0e31a6acd34542fbb179639c6ef7844b"},{"sequence":3,"submissionId":20090020655,"meta":{"author":{"name":"O'Hara, William"},"organization":{"name":"Lockheed Martin Corp.","location":"Houston, TX, United States"}},"id":"b6ee77820d28484b9b279ee632f0345f"},{"sequence":4,"submissionId":20090020655,"meta":{"author":{"name":"Lewis, John F."},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"46437899b5ff477fa53a2d383328218e"}],"stiTypeDetails":"Preprint (Draft being sent to journal)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20090020655,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-24T18:30:00.0000000+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The Orion Crew Exploration Vehicle (CEV) requires a smoke detector for the detection of particulate smoke products as part of the Fire Detection and Suppression (FDS) system. The smoke detector described in this paper is an adaptation of a mature commercial aircraft design for manned spaceflight. Changes made to the original design include upgrading the materials and electronic to space-qualified parts, and modifying the mechanical design to withstand launch and landing loads. The results of laboratory characterization of the response of the new design to test particles are presented.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","meetings":[{"country":"United States","submissionId":20090020655,"endDate":"2009-07-16T00:00:00.0000000+00:00","sponsors":[{"organizationId":"2fb8633154d94728aec2c57afa709b46","meta":{"organization":{"name":"Society of Automotive Engineers, Inc.","location":"Warrendale, PA, United States"}},"meetingId":"287b6864c0b842cc85d3c1332a66dc17","id":"55d6298a8ffd463fb2d53a7ef814947c"}],"name":"ICES 2009","location":"Savannah, GA","id":"287b6864c0b842cc85d3c1332a66dc17","startDate":"2009-07-12T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20090020655,"id":"9adb263638174b92ac23dbae62c4de0f","publicationDate":"2009-01-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":132.06396},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20110006323,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"8351a86ae89145ffb23d6166f666a19c","belongsToAuthors":false},"subjectCategories":["Spacecraft Design, Testing And Performance"],"exportControl":{"isExportControl":"NO","submissionId":20110006323,"ear":"NO","id":"6ce9f6b3cd5e4edca3c056e484f8a1dd","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["JSC-CN-22902","JSC-CN-24161","Report Number: JSC-CN-22902","Report Number: JSC-CN-24161"],"fundingNumbers":[{"number":"WBS 644423.06.31.03.15.10","submissionId":20110006323,"id":"20385d33f4fb498cb36608660c924c87","type":"WBS"}],"title":"Assessment of an Automated Touchdown Detection Algorithm for the Orion Crew Module","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-25T08:55:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20110006323,"meta":{"author":{"name":"Gay, Robert S."},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"14745f673d124fb98681bbf22676cbf7"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20110006323,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-25T08:55:00.0000000+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Orion Crew Module (CM) touchdown detection is critical to activating the post-landing sequence that safe?s the Reaction Control Jets (RCS), ensures that the vehicle remains upright, and establishes communication with recovery forces. In order to accommodate safe landing of an unmanned vehicle or incapacitated crew, an onboard automated detection system is required. An Orion-specific touchdown detection algorithm was developed and evaluated to differentiate landing events from in-flight events. The proposed method will be used to initiate post-landing cutting of the parachute riser lines, to prevent CM rollover, and to terminate RCS jet firing prior to submersion. The RCS jets continue to fire until touchdown to maintain proper CM orientation with respect to the flight path and to limit impact loads, but have potentially hazardous consequences if submerged while firing. The time available after impact to cut risers and initiate the CM Up-righting System (CMUS) is measured in minutes, whereas the time from touchdown to RCS jet submersion is a function of descent velocity, sea state conditions, and is often less than one second. Evaluation of the detection algorithms was performed for in-flight events (e.g. descent under chutes) using hi-fidelity rigid body analyses in the Decelerator Systems Simulation (DSS), whereas water impacts were simulated using a rigid finite element model of the Orion CM in LS-DYNA. Two touchdown detection algorithms were evaluated with various thresholds: Acceleration magnitude spike detection, and Accumulated velocity changed (over a given time window) spike detection. Data for both detection methods is acquired from an onboard Inertial Measurement Unit (IMU) sensor. The detection algorithms were tested with analytically generated in-flight and landing IMU data simulations. The acceleration spike detection proved to be faster while maintaining desired safety margin. Time to RCS jet submersion was predicted analytically across a series of simulated Orion landing conditions. This paper details the touchdown detection method chosen and the analysis used to support the decision.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"submissionId":20110006323,"name":"American Inst. of Aeronautics and Astronautics","location":"Reston, VA, United States","id":"8f95ab9fcf634f0dba7f82c496c59a40"},{"country":"United States","submissionId":20110006323,"endDate":"2011-08-11T00:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"American Inst. of Aeronautics and Astronautics","location":"Reston, VA, United States"}},"meetingId":"039c354f078f49f7ae1d3455874f9b7f","id":"e26e8a7070124320a809a60832ca87f1"}],"name":"AIAA Guidance, Navigation,and Control Conference","location":"Portland, OR","id":"039c354f078f49f7ae1d3455874f9b7f","startDate":"2011-08-08T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20110006323,"id":"41566a8bb7fa4c7098627de2249c6613","publicationDate":"2011-01-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20110006323.pdf","type":"STI","links":{"original":"/api/citations/20110006323/downloads/20110006323.pdf","pdf":"/api/citations/20110006323/downloads/20110006323.pdf","fulltext":"/api/citations/20110006323/downloads/20110006323.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":108.84816},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20200000365,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"937a46f37dbe409b9bbb1698c0541449","belongsToAuthors":false},"subjectCategories":["Space Transportation And Safety"],"exportControl":{"isExportControl":"NO","eccnNumber":"","submissionId":20200000365,"ear":"NO","id":"9a2c9e05c09e44feb811019d125547ed","itar":"NO"},"distributionDate":"2020-01-17T19:19:59.8670000+00:00","otherReportNumbers":["GRC-E-DAA-TN75331","Report Number: GRC-E-DAA-TN75331"],"fundingNumbers":[{"number":"089407.02.04.22","submissionId":20200000365,"id":"1d546fabe2b44663a09ede9ab4d9d844","type":"WBS"},{"number":"NNC13BA10B","submissionId":20200000365,"id":"6d4efd3587fe4e58a53c51d69944585b","type":"CONTRACT_GRANT"}],"title":"Hazardous Product Detection and Environmental Clean-up Removal in Spacecraft Vehicles from Fire Induced Li-Ion Fires","stiType":"PRESENTATION","distribution":"PUBLIC","submittedDate":"2020-01-16T10:46:05.1700000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20200000365,"meta":{"author":{"name":"Padilla, Rosa E."},"organization":{"name":"Universities Space Research Association (USRA)","location":"Cleveland, OH, United States"}},"id":"7555c2c0d25643049bf5f2c82ef0e0d5"},{"sequence":1,"submissionId":20200000365,"meta":{"author":{"name":"Miller, Thomas B."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"bfca5dbb4ab441b79db33227f499a9c8"},{"sequence":2,"submissionId":20200000365,"meta":{"author":{"name":"Dietrich, Daniel L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"1abf14244bfa4dfa9bea43a70016edd5"},{"sequence":3,"submissionId":20200000365,"meta":{"author":{"name":"Ruff, Gary"},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"9eb6456eead04f7db3246a2752ab7d68"},{"sequence":4,"submissionId":20200000365,"meta":{"author":{"name":"Urban, David L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"4cf790b5de8147188d26b65b46989b4f"}],"stiTypeDetails":"Presentation","technicalReviewType":"SINGLE_EXPERT","modified":"2025-08-31T18:39:21.7150190+00:00","id":20200000365,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2020-01-16T10:46:05.1700000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"A fire on-board the International Space Station (ISS) resulting from a commercial Surface Pro tablet Lithium-Ion (Li-ion) battery can be detrimental to the spacercraft and the astronauts. The Spacecraft Fire Safety Demonstration (Saffire) program is focused on identifying and quantifying the risks that potentially arise inside a space vehicle by conducting large fire experiments inside the Cygnus cargo vehicle upon re-entry to Earth. The potential candidate that will be flown on the ISS is a 4- cell Li-ion battery pack Surface Pro tablet (42 Wh). The tablets were tested at the White Sands Test Facility (WSTF) using a localized heating method to emulate the failing mechanism that leads the unit into thermal runaway. Measurements inside the test chamber were performed on aerosol mass concentrations and for specific toxic products (i.e. from CO, HCN, HCl and CO2). These toxic products depend on the size of the fire and energy content of the tablet. Comparisons will be made with the Dell XPS (97 Wh). The concentrations are then used to extrapolate to laptop fires on a vehicle at the approximate volumetric size of the Orion spacecraft. The presentation provides an analysis on the detection capability and the response time to trigger fire alarms aboard a vehicle by using the mass concentration levels. These results will consider the rate at which the life support system is able to filter the atmosphere in order to provide a hazardous free environment.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"United States","submissionId":20200000365,"endDate":"2019-11-21T00:00:00.0000000+00:00","sponsors":[{"organizationId":"599569eabb93418db42fa10e3294bd52","meta":{"organization":{"name":"NASA Marshall Space Flight Center","location":"Huntsville, AL, United States"}},"meetingId":"82230c266c0840839e65f48e84ba8598","id":"53305a152e074b1c8622e42f9cbd165f"}],"name":"NASA Aerospace Battery Workshop","location":"Huntsville, AL","id":"82230c266c0840839e65f48e84ba8598","startDate":"2019-11-19T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20200000365,"id":"3c6057e477f147509ed398171297c1ea","publicationDate":"2019-11-19T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20200000365.pdf","type":"STI","links":{"original":"/api/citations/20200000365/downloads/20200000365.pdf","pdf":"/api/citations/20200000365/downloads/20200000365.pdf","fulltext":"/api/citations/20200000365/downloads/20200000365.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"buckets":[{"key_as_string":"2013","key":1356998400000,"doc_count":2},{"key_as_string":"2020","key":1577836800000,"doc_count":1}]},"author":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"Dietrich, Daniel L.","doc_count":1},{"key":"Gay, Robert S.","doc_count":1},{"key":"Lewis, John F.","doc_count":1},{"key":"Miller, Thomas B.","doc_count":1},{"key":"Niu, William","doc_count":1},{"key":"O'Hara, William","doc_count":1},{"key":"Padilla, Rosa E.","doc_count":1},{"key":"Ruff, Gary","doc_count":1},{"key":"Steiner, George","doc_count":1},{"key":"Sutin, Brian M.","doc_count":1},{"key":"Urban, David L.","doc_count":1}]},"reportNumber":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"09ICES-0035","doc_count":1},{"key":"GRC-E-DAA-TN75331","doc_count":1},{"key":"JSC-CN-18294","doc_count":1},{"key":"JSC-CN-22902","doc_count":1},{"key":"JSC-CN-24161","doc_count":1},{"key":"Report Number: 09ICES-0035","doc_count":1},{"key"