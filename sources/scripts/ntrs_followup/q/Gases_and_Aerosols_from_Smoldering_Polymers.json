earch Center","location":"Cleveland, United States"}},"id":"a8a3caa62b944e4597dd0a1a35caf2b5","userType":"CIVIL","userId":"4bdd8f4605e2481e8492acefd92cf0d3"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":3,"submissionId":20260005612,"meta":{"author":{"orcidId":"","name":"Matthew Prelich"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"4a87ba790fd14418abbb553850bbf4c4","userType":"CIVIL","userId":"784aec318eb44528831ac73bc7d73b30"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":4,"submissionId":20260005612,"meta":{"author":{"orcidId":"","name":"David Urban"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"12395ef6faec4434a63eae3eba1ce169","userType":"CIVIL","userId":"e6ad9f3a70a94fc1a0a4a56bb211746a"}],"stiTypeDetails":"Poster","technicalReviewType":"SINGLE_EXPERT","modified":"2026-06-26T12:47:07.2998260+00:00","id":20260005612,"created":"2026-06-22T14:38:41.8551050+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"We present preliminary results on the development of a fire detection system for partial and low gravity environments. A significant challenge is the design of a system with a low false alarm rate. The detection system therefore has to discriminate between combustion particles, cabin, and lunar dust.  Aerosol properties are measured and cross referenced to the target detectors at the Gases and Aerosols from Smoldering Polymers (GASP) Laboratory located at the NASA Glenn Research Center. A computational fluid dynamics plume model is also employed to determine the smoke transport properties of the targeted habitats.  ","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20260005612,"id":"2e140514ee13427a8fef4fcaa6d17014"},"meetings":[{"country":"US","submissionId":20260005612,"en