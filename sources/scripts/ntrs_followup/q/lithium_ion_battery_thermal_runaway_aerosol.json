a"},"organization":{"name":"Universities Space Research Association","location":"Columbia, United States"}},"id":"6d5da3574c144e64bc915fb7898b8e18","userType":"CONTRACTOR_GRANTEE","userId":"1dcf79df71a44fcd8a2e05b7152da454"},{"organizationId":"0be91b7a68665cf882c2ccee8ad03aff","sequence":3,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"Gordon Berger"},"organization":{"name":"Universities Space Research Association","location":"Columbia, United States"}},"id":"dcbf365cb02d49658455ef0767f6189c","userType":"CONTRACTOR_GRANTEE","userId":"693850a66a124a308a32ad528c31595c"},{"organizationId":"0be91b7a68665cf882c2ccee8ad03aff","sequence":4,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"Jay Owens"},"organization":{"name":"Universities Space Research Association","location":"Columbia, United States"}},"id":"56843c463a264f7eb09f61ceb839eb98","userType":"CONTRACTOR_GRANTEE","userId":"6a727331070245f48669f2973eb3198b"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":5,"submissionId":20250005133,"meta":{"author":{"name":"Claire Fortenberry"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"159b04176e734b6595bdf68440c34ab3","userType":"CIVIL","userId":"b9cd289657ad4b388c09d1692901b134"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":6,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"David Urban"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"e23cfc77ca8241d1a85faee1eaf53fc3","userType":"CIVIL","userId":"e6ad9f3a70a94fc1a0a4a56bb211746a"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":7,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"Daniel Dietrich"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"d7b44f802c86494c89065153211602fb","userType":"CIVIL","userId":"addb6443628246ef86b6e9dabd8e81dd"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":8,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"Thomas Miller"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"a9b4d1414a2f498f98f8d8e711a5d70c","userType":"CIVIL","userId":"658cf1a0ed0d427b9e362d98a71d66ef"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":9,"submissionId":20250005133,"meta":{"author":{"orcidId":"","name":"Thomas DeMichael"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"ad96b71215264a01878bf7048d5d6f9f","userType":"CIVIL","userId":"dcecae553fac49ef9e48e381922e92a9"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"SINGLE_EXPERT","modified":"2025-08-31T18:39:21.7150190+00:00","id":20250005133,"created":"2025-05-15T19:01:32.0963000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Lithium-ion batteries power a large and increasing number and variety of electronic devices, hand tools, and larger machinery, including automobiles, inevitably finding use in crewed space missions. Under abusive use conditions or due to manufacturing defects, these batteries can experience thermal runaway, where the battery electrolyte reacts, generating heat, aerosol, toxic gas products, and potentially flames, posing a threat to the enclosed, recycled atmosphere of a space vehicle. Beginning an effort to quantify the effects of thermal runaway in a crewed vehicle or habitat, the authors built an enclosure and flow measurement system, capturing products to measure heat release rate, aerosol, and gas products evolving from thermal runaway. The scale of these current and future tests ranges from individual battery cells to laptop battery packs and full-sized laptop computers. An initial series of tests examined the burning rate of ethanol pool fires of two different sizes, simulating an individual battery cell fire and a battery pack fire, respectively. These results showed good agreement in heat release rate in comparison to a heat of combustion analysis, validating the apparatus. A second series of tests examined the thermal runaway of the two 2500 mAh battery cell types. These results quantified the heat release rate and gas products produced during the thermal runaway of the tested battery cells. It also showed different responses between different batteries in terms of aerosol production and heat release, showing the need to test specific battery components in terms of heat and products produced. ","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20250005133,"id":"7610237b789b436abd2b1b0458f0baca"},"meetings":[{"country":"CZ","submissionId":20250005133,"endDate":"2025-07-17T04:00:00.0000000+00:00","sponsors":[{"organizationId":"8a4c6bb4d92d4b57b245023ae13c7536","meta":{"organization":{"name":"International Conference on Environmental Systems","location":"Emmaus, Pennsylvania, United States"}},"meetingId":"8944d887cfdd49e186118656bc568af4","id":"b244fc1bb01a4f55b77976accdd2d16b"}],"name":"54th International Conference on Environmental Systems","location":"Prague","id":"8944d887cfdd49e186118656bc568af4","url":"https://ices.space/","startDate":"2025-07-13T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"ICES_Fina_426.pdf","notes":"false positive","type":"STI","links":{"original":"/api/citations/20250005133/downloads/ICES_Fina_426.pdf","pdf":"/api/citations/20250005133/downloads/ICES_Fina_426.pdf","fulltext":"/api/citations/20250005133/downloads/ICES_Fina_426.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":305.51907},"copyright":{"disclosedInvention":false,"submissionId":20250006898,"containsThirdPartyMaterial":false,"containsIndication":false,"belongsToPublisher":false,"id":"918294521a59